// Prisma schema file for EUNOIA OS Database

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String             @id // Clerk User ID (passed as string)
  email            String             @unique
  name             String?
  role             String             @default("USER") // USER, ADMIN, GUEST
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  goals            Goal[]
  tasks            Task[]
  skills           Skill[]
  roadmaps         Roadmap[]
  resumes          Resume[]
  simulations      Simulation[]
  learningProgress LearningProgress[]
  activities       Activity[]
  analytics        Analytics[]

  @@index([email])
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([goalId])
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  level     String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, EXPERT
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Roadmap {
  id          String   @id @default(uuid())
  title       String
  description String?
  steps       Json     // AI Generated node path steps
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Resume {
  id        String   @id @default(uuid())
  content   Json     // Parsed resumes structures for AI extraction
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Simulation {
  id         String   @id @default(uuid())
  type       String   // INTERVIEW, NEGOTIATION
  scenario   String
  transcript Json?    // Full AI message chat exchanges history
  score      Int?
  feedback   String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model LearningProgress {
  id        String   @id @default(uuid())
  topic     String
  percent   Float    @default(0.0)
  completed Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Activity {
  id        String   @id @default(uuid())
  action    String   // LOGGED_IN, CREATE_TASK, ASK_AI
  metadata  Json?    // Context payload
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Analytics {
  id        String   @id @default(uuid())
  metrics   Json     // Dynamic KPI data points
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
